# Dependencies
node_modules/

# Build output
dist/
build/

# Build caches & incremental artifacts
.turbo/
*.tsbuildinfo
*.log

# Generated scan reports (ad-hoc dev output)
packages/cli/report.json
packages/cli/test-report.json

# Downloaded build tooling (fetched on demand, never committed)
packages/sandbox-service/protoc_bin/
packages/sandbox-service/protoc-*.zip

# Compiled Go sandbox binary — built into the CLI at build/release time
