# it once with:  git rm --cached packages/cli/bin/wh-sandbox
packages/cli/bin/wh-sandbox

# Compiled experimental shield-agent binary (build artifact, not committed)
experimental/shield-agent/shield-agent-bin

# Python artifacts
__pycache__/
*.pyc
.venv/
*.egg-info/

# OS / editor cruft
.DS_Store
