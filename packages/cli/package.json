{
  "name": "wh-agent-cli",
  "version": "1.6.0",
  "description": "W.H.Agent CLI",
  "keywords": [
    "ai",
    "agent",
    "security",
    "antivirus",
    "sandbox",
    "mcp",
    "model context protocol",
    "llm",
    "guardrail",
    "static analysis"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shield": "dist/index.js",
    "wh-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "bin/wh-sandbox",
    "packs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:sandbox": "mkdir -p bin && cd ../sandbox-service && go build -o ../cli/bin/wh-sandbox ./cmd/wh-sandbox",
    "prepublishOnly": "npm run build:sandbox && npm run build",
    "dev": "ts-node src/index.ts",
    "lint": "biome lint src",
    "check": "biome check .",
    "update-popular-packages": "node scripts/update-popular-packages.js",
    "test": "bun test && pnpm run test:ast",
    "test:ast": "tsx --test src/core-scanner/parser.nodetest.ts src/core-scanner/taint/polyglot.nodetest.ts src/commands/guard.nodetest.ts src/core-scanner/patterns/patterns.nodetest.ts src/core-scanner/shell/normalize.nodetest.ts src/core-scanner/corpus/corpus.nodetest.ts src/e2e.nodetest.ts src/commands/install.nodetest.ts src/util/untrusted-text.nodetest.ts src/core-scanner/watch/state.nodetest.ts",
    "type-check": "tsc --noEmit",
    "prepack": "npm run build:sandbox && npm run build",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "glob": "^13.0.6",
    "tar": "^7.5.16",
    "tree-sitter": "^0.25.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "@anthropic-ai/sdk": "^0.104.1",
    "web-tree-sitter": "^0.26.10"
  },
  "license": "FCL-1.0-ALv2",
  "overrides": {
    "tree-sitter": "$tree-sitter"
  }
}
